<% content_for :title, "Écoute" %>

<div class="px-4 pt-6 pb-4">
  <h1 class="text-2xl font-bold text-sp-primary mb-1">Écoute</h1>
  <p class="text-sm text-gray-500">Sélectionnez un patient pour démarrer la session.</p>
</div>

<div class="px-4 flex flex-col gap-3">

  <%# Nouveau patient + écoute directe %>
  <%= link_to new_patient_path(redirect_to_recording: true),
        class: "flex items-center gap-3 bg-sp-primary text-white rounded-2xl p-4 shadow-sm" do %>
    <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
    </div>
    <div>
      <p class="font-semibold text-sm">Nouveau patient</p>
      <p class="text-xs text-white/70">Créer un patient puis démarrer l'écoute</p>
    </div>
  <% end %>

  <% if @patients.any? %>
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mt-2">Patients existants</p>

    <% @patients.each do |patient| %>
      <%= link_to recording_patient_bilan_path(patient),
            class: "flex items-center gap-3 bg-white rounded-2xl p-4 shadow-sm" do %>
        <div class="w-10 h-10 rounded-full <%= patient_avatar_color(patient.name) %> flex items-center justify-center shrink-0">
          <span class="text-sm font-bold text-gray-700"><%= patient_initials(patient.name) %></span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm text-sp-primary truncate"><%= patient.name %></p>
          <p class="text-xs text-gray-400 truncate">
            <% if patient.pathology.present? %>
              <%= patient.pathology %>
            <% else %>
              <%= patient.age.present? ? "#{patient.age} ans" : "Aucune info" %>
            <% end %>
          </p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-sp-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
        </svg>
      <% end %>
    <% end %>

  <% else %>
    <div class="text-center py-10 text-gray-400 text-sm">
      Aucun patient enregistré.
    </div>
  <% end %>

</div>
