<div class="bg-white rounded-2xl p-5 shadow-sm">
  <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Notes manuelles</p>
  <div class="flex flex-col divide-y divide-gray-100">
    <% bilan.manual_notes.sort_by { |n| n["timestamp_seconds"] }.each do |note| %>
      <div class="flex gap-3 py-2.5">
        <% m = note["timestamp_seconds"] / 60 %>
        <% s = note["timestamp_seconds"] % 60 %>
        <span class="text-xs text-sp-accent font-mono shrink-0 pt-0.5 w-10"><%= format("%02d:%02d", m, s) %></span>
        <p class="text-sm text-gray-700 leading-relaxed"><%= note["text"] %></p>
      </div>
    <% end %>
  </div>
</div>
