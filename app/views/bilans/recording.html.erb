<% content_for :title, "Écoute — #{@patient.name}" %>

<div data-controller="recording"
     data-recording-upload-chunk-url-value="<%= upload_chunk_patient_bilan_path(@patient) %>"
     data-recording-add-manual-note-url-value="<%= add_manual_note_patient_bilan_path(@patient) %>"
     data-recording-finalize-url-value="<%= finalize_patient_bilan_path(@patient) %>"
     class="flex flex-col min-h-screen bg-sp-bg">

  <%# Header %>
  <div class="flex items-center justify-between px-4 py-4 bg-sp-bg sticky top-0 z-10">
    <%= link_to patient_path(@patient), class: "flex items-center gap-1 text-sp-accent text-sm font-medium" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      <%= @patient.name %>
    <% end %>
    <h1 class="text-base font-semibold text-sp-primary">Écoute</h1>
    <div class="w-16"></div><%# espaceur pour centrer le titre %>
  </div>

  <div class="flex-1 flex flex-col px-4 pb-6 gap-6">

    <%# Timer %>
    <div class="flex flex-col items-center pt-8 pb-4 gap-4">
      <span data-recording-target="timer"
            class="text-5xl font-mono font-bold text-sp-primary tabular-nums">
        00:00:00
      </span>
      <p data-recording-target="status" class="text-sm text-sp-accent italic min-h-[1.25rem]"></p>
    </div>

    <%# Boutons de contrôle %>
    <div class="flex justify-center gap-4">

      <%# Démarrer (visible au départ) %>
      <button data-recording-target="startBtn"
              data-action="click->recording#start"
              class="flex items-center gap-2 px-6 py-3 rounded-full bg-sp-primary text-white font-semibold text-sm shadow">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="6"/>
        </svg>
        Démarrer
      </button>

      <%# Pause (caché au départ) %>
      <button data-recording-target="pauseBtn"
              data-action="click->recording#pause"
              class="hidden flex items-center gap-2 px-5 py-3 rounded-full border border-sp-primary text-sp-primary font-semibold text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <rect x="6" y="5" width="4" height="14" rx="1"/>
          <rect x="14" y="5" width="4" height="14" rx="1"/>
        </svg>
        Pause
      </button>

      <%# Reprendre (caché au départ) %>
      <button data-recording-target="resumeBtn"
              data-action="click->recording#resume"
              class="hidden flex items-center gap-2 px-5 py-3 rounded-full border border-sp-primary text-sp-primary font-semibold text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        Reprendre
      </button>

      <%# Terminer (caché au départ) %>
      <button data-recording-target="stopBtn"
              data-action="click->recording#finalize"
              class="hidden flex items-center gap-2 px-5 py-3 rounded-full bg-red-500 text-white font-semibold text-sm shadow">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <rect x="5" y="5" width="14" height="14" rx="2"/>
        </svg>
        Terminer
      </button>

    </div>

    <%# Note manuelle — toujours disponible %>
    <div class="bg-white rounded-2xl p-4 shadow-sm">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Note manuelle</p>
      <div class="flex gap-2 items-end">
        <textarea data-recording-target="manualInput"
                  data-action="keydown->recording#onNoteKeydown"
                  placeholder="Ajouter une observation à cet instant…"
                  rows="2"
                  class="flex-1 text-sm text-gray-800 placeholder-gray-400 bg-transparent focus:outline-none resize-none leading-relaxed"></textarea>
        <button data-action="click->recording#addManualNote"
                class="shrink-0 px-3 py-2 rounded-xl bg-sp-primary text-white text-xs font-semibold">
          Ajouter
        </button>
      </div>
    </div>

    <%# Liste des notes manuelles ajoutées pendant la session %>
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">Notes de la session</p>
      <div data-recording-target="notesList" class="flex flex-col gap-1">
        <% if @bilan.manual_notes.any? %>
          <% @bilan.manual_notes.sort_by { |n| n["timestamp_seconds"] }.reverse.each do |note| %>
            <div class="flex gap-2 text-sm text-gray-700 py-1 border-b border-gray-100">
              <% m = note["timestamp_seconds"] / 60 %>
              <% s = note["timestamp_seconds"] % 60 %>
              <span class="text-xs text-sp-accent font-mono shrink-0 pt-0.5"><%= format("%02d:%02d", m, s) %></span>
              <span><%= note["text"] %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

  </div>

  <%# Modal de confirmation %>
  <div data-recording-target="confirmModal"
       class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-6">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6">
      <h2 class="text-base font-bold text-sp-primary mb-2">Terminer l'écoute ?</h2>
      <p class="text-sm text-gray-500 mb-6">Le bilan sera généré par l'IA à partir de la transcription et de vos notes.</p>
      <div class="flex gap-3">
        <button data-action="click->recording#cancelFinalize"
                class="flex-1 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-gray-600">
          Annuler
        </button>
        <button data-action="click->recording#confirmFinalize"
                class="flex-1 py-2.5 rounded-xl bg-sp-primary text-white text-sm font-semibold">
          Générer le bilan
        </button>
      </div>
    </div>
  </div>

</div>
