<% content_for :title, "Bilan — #{@patient.name}" %>

<%# Rafraîchissement automatique pendant la synthèse IA %>
<% if @bilan.status == "processing" %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="4">
  <% end %>
<% end %>

<%# Header %>
<div class="flex items-center justify-between px-4 py-4 bg-sp-bg sticky top-0 z-10">
  <%= link_to patient_path(@patient), class: "flex items-center gap-1 text-sp-accent text-sm font-medium" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    <%= @patient.name %>
  <% end %>
  <h1 class="text-base font-semibold text-sp-primary">Bilan</h1>
  <% if @bilan.status == "done" %>
    <%= link_to edit_patient_bilan_path(@patient), class: "w-8 h-8 rounded-lg bg-white flex items-center justify-center shadow-sm" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
    <% end %>
  <% else %>
    <div class="w-8"></div>
  <% end %>
</div>

<div class="px-4 pb-6 flex flex-col gap-5">

  <% if @bilan.status == "processing" %>

    <%# État : synthèse en cours %>
    <div class="flex flex-col items-center justify-center py-20 gap-4">
      <div class="w-12 h-12 rounded-full border-4 border-sp-accent border-t-transparent animate-spin"></div>
      <p class="text-sm font-semibold text-sp-primary">Génération du bilan en cours…</p>
      <p class="text-xs text-gray-400 text-center">L'IA analyse la transcription.<br>Cette page se rafraîchit automatiquement.</p>
    </div>

    <%# On affiche quand même les notes manuelles déjà disponibles %>
    <% if @bilan.manual_notes.any? %>
      <%= render "manual_notes", bilan: @bilan %>
    <% end %>

  <% elsif @bilan.status == "done" %>

    <%# Méta-infos de la session %>
    <div class="flex items-center gap-3 text-xs text-gray-400">
      <% if @bilan.duration_seconds > 0 %>
        <% h = @bilan.duration_seconds / 3600 %>
        <% m = (@bilan.duration_seconds % 3600) / 60 %>
        <% s = @bilan.duration_seconds % 60 %>
        <span class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <%= h > 0 ? "#{h}h " : "" %><%= m > 0 ? "#{m}min " : "" %><%=  %>s
        </span>
      <% end %>
      <span><%= @bilan.updated_at.strftime("%-d %b %Y à %H:%M") %></span>
    </div>

    <%# Synthèse IA %>
    <div class="bg-white rounded-2xl p-5 shadow-sm">
      <p class="text-xs font-semibold text-sp-accent uppercase tracking-widest mb-3 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        Synthèse IA
      </p>
      <div class="prose prose-sm text-gray-800 max-w-none"><%= render_markdown(@bilan.content) %></div>
    </div>

    <%# Notes manuelles %>
    <% if @bilan.manual_notes.any? %>
      <%= render "manual_notes", bilan: @bilan %>
    <% end %>

  <% else %>

    <%# État idle / recording inattendu — bouton pour lancer l'écoute %>
    <div class="flex flex-col items-center justify-center py-20 gap-4">
      <p class="text-sm text-gray-500">Aucun bilan généré pour l'instant.</p>
      <%= link_to recording_patient_bilan_path(@patient),
            class: "px-6 py-3 rounded-full bg-sp-primary text-white font-semibold text-sm" do %>
        Démarrer une écoute
      <% end %>
    </div>

  <% end %>

</div>
