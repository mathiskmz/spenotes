<% content_for :title, "Mes patients" %>

<div class="px-4 pt-6">
  <%# Header %>
  <div class="flex items-start justify-between mb-5">
    <div>
      <p class="text-sm text-gray-500">Bonjour, <%= current_user.name.presence || current_user.email.split("@").first %></p>
      <h1 class="text-2xl font-bold text-sp-primary">Mes patients</h1>
    </div>
    <%= link_to new_patient_path, class: "w-10 h-10 rounded-full bg-sp-primary flex items-center justify-center flex-shrink-0" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
    <% end %>
  </div>

  <%# Stats %>
  <div class="grid grid-cols-2 gap-3 mb-5">
    <div class="bg-white rounded-2xl p-4 text-center shadow-sm">
      <p class="text-3xl font-bold text-sp-primary"><%= @patients.count %></p>
      <p class="text-xs text-gray-500 mt-1">Patients actifs</p>
    </div>
    <div class="bg-white rounded-2xl p-4 text-center shadow-sm">
      <p class="text-3xl font-bold text-sp-primary"><%= @notes_this_week %></p>
      <p class="text-xs text-gray-500 mt-1">Notes cette semaine</p>
    </div>
  </div>

  <%# Liste patients %>
  <% if @patients.any? %>
    <p class="text-xs font-semibold text-gray-400 tracking-widest uppercase mb-3">Récents</p>
    <div class="flex flex-col gap-3">
      <% @patients.each do |patient| %>
        <div class="bg-white rounded-2xl p-4 shadow-sm flex items-center gap-3">
          <%# Avatar initiales %>
          <div class="w-12 h-12 rounded-full <%= patient_avatar_color(patient.name) %> flex items-center justify-center flex-shrink-0">
            <span class="text-sm font-bold text-gray-700"><%= patient_initials(patient.name) %></span>
          </div>

          <%# Infos patient %>
          <%= link_to patient_path(patient), class: "flex-1 min-w-0" do %>
            <p class="font-semibold text-sp-primary truncate"><%= patient.name %></p>
            <p class="text-sm text-gray-500 truncate"><%= patient.pathology.presence || "Aucune pathologie renseignée" %></p>
            <p class="text-xs text-gray-400 mt-1 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <%= patient.updated_at.strftime("%-d %b %Y") %>
            </p>
          <% end %>

          <%# Actions %>
          <div class="flex gap-2 flex-shrink-0">
            <%= link_to edit_patient_path(patient), class: "w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            <% end %>
            <%= button_to patient_path(patient), method: :delete,
                data: { turbo_confirm: "Supprimer #{patient.name} et toutes ses notes ? Cette action est irréversible." },
                class: "w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center border-0 cursor-pointer" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sp-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16">
      <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-sp-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <p class="text-gray-500 text-sm">Aucun patient pour l'instant</p>
      <%= link_to "Ajouter un patient", new_patient_path, class: "mt-4 inline-block text-sm font-medium text-sp-accent" %>
    </div>
  <% end %>
</div>
