<% content_for :title, "Modifier le patient" %>

<%# Header %>
<div class="flex items-center justify-between px-4 py-4">
  <%= link_to patient_path(@patient), class: "flex items-center gap-1 text-sp-accent text-sm font-medium" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    Patients
  <% end %>
  <h1 class="text-base font-semibold text-sp-primary">Modifier le patient</h1>
  <div class="w-16"></div>
</div>

<div class="px-4">
  <%= render 'form', patient: @patient %>

  <%# Zone dangereuse %>
  <div class="mt-8 border border-red-200 rounded-2xl p-4">
    <p class="text-xs font-semibold text-red-500 uppercase tracking-wide mb-3">⚠ Zone dangereuse</p>
    <p class="text-xs text-gray-500 mb-4">La suppression de ce patient et de toutes ses notes est irréversible.</p>
    <%= button_to patient_path(@patient), method: :delete,
        data: { turbo_confirm: "Supprimer #{@patient.name} et toutes ses notes ? Cette action est irréversible." },
        class: "w-full py-3 rounded-xl bg-red-50 text-sp-danger font-semibold text-sm border border-red-200 cursor-pointer" do %>
      Supprimer ce patient
    <% end %>
  </div>
</div>
