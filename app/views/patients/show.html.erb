<% content_for :title, @patient.name %>
<% last_note = @notes.first %>

<%# Header %>
<div class="flex items-center justify-between px-4 py-4 bg-sp-bg sticky top-0 z-10">
  <%= link_to patients_path, class: "flex items-center gap-1 text-sp-accent text-sm font-medium" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    Patients
  <% end %>
  <h1 class="text-base font-semibold text-sp-primary">Fiche patient</h1>
  <%= link_to edit_patient_path(@patient), class: "w-8 h-8 rounded-lg bg-white flex items-center justify-center shadow-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
    </svg>
  <% end %>
</div>

<div class="px-4 pb-6">

  <%# Hero patient %>
  <div class="bg-white rounded-2xl p-5 shadow-sm mb-5 flex items-center gap-4">
    <div class="w-16 h-16 rounded-full <%= patient_avatar_color(@patient.name) %> flex items-center justify-center flex-shrink-0">
      <span class="text-xl font-bold text-gray-700"><%= patient_initials(@patient.name) %></span>
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-xl font-bold text-sp-primary leading-tight"><%= @patient.name %></p>
      <p class="text-sm text-gray-500 mt-0.5">
        <% if @patient.age.present? %><%= @patient.age %> ans · <% end %>Suivi depuis <%= @patient.created_at.strftime("%-d %b %Y") %>
      </p>
      <% if @patient.pathology.present? %>
        <p class="text-sm font-semibold text-sp-primary mt-1"><%= @patient.pathology %></p>
      <% end %>
    </div>
  </div>

  <%# Prochaine séance %>
  <p class="text-xs font-semibold text-gray-400 tracking-widest uppercase mb-2">Prochaine séance</p>
  <div class="bg-white rounded-2xl p-4 shadow-sm mb-5">

    <%# Notes rapides praticien %>
    <div class="mb-4" data-controller="quick-note">

      <%# En-tête %>
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-bold text-gray-500 uppercase tracking-widest flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Notes praticien
        </p>
        <button data-action="click->quick-note#startEdit"
                class="w-6 h-6 flex items-center justify-center rounded-lg bg-gray-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </button>
      </div>

      <%# Vue lecture %>
      <div data-quick-note-target="view">
        <% if @patient.note_rapide.present? %>
          <p data-quick-note-target="text"
             class="text-sm text-gray-800 leading-relaxed whitespace-pre-wrap line-clamp-3">
            <%= @patient.note_rapide %>
          </p>
          <button data-action="click->quick-note#expand"
                  data-quick-note-target="expandBtn"
                  class="text-xs text-sp-accent font-medium mt-1">
            Voir plus
          </button>
        <% else %>
          <p class="text-xs text-gray-400 italic">Appuyez sur ✏️ pour ajouter une note rapide.</p>
        <% end %>
      </div>

      <%# Vue édition %>
      <div data-quick-note-target="form" class="hidden">
        <%= form_with model: @patient, url: patient_path(@patient), method: :patch do |f| %>
          <%= f.text_area :note_rapide,
                placeholder: "Notes pour la prochaine séance…",
                rows: 4,
                class: "w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent resize-none leading-relaxed" %>
          <div class="flex gap-2 mt-2">
            <button type="button"
                    data-action="click->quick-note#cancelEdit"
                    class="flex-1 py-2 rounded-xl border border-gray-200 text-sm text-gray-500">
              Annuler
            </button>
            <%= f.submit "Enregistrer",
                  class: "flex-1 py-2 rounded-xl bg-sp-primary text-white text-sm font-semibold cursor-pointer" %>
          </div>
        <% end %>
      </div>

    </div>

    <%# Recommandations IA %>
    <div class="border-t border-gray-100 pt-4 <%= @patient.bilan&.status == 'done' ? '' : 'opacity-50' %>">
      <p class="text-xs font-bold text-sp-accent uppercase tracking-widest mb-2 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        Assistant - recommandations
      </p>
      <% if @patient.bilan&.status == "done" || @patient.bilan&.status == "processing" %>
        <%= turbo_stream_from "bilan_recommendations_#{@patient.id}" %>
        <turbo-frame id="bilan_recommendations_<%= @patient.id %>">
          <%= render "patients/bilan_recommendations", bilan: @patient.bilan %>
        </turbo-frame>
      <% else %>
        <p class="text-xs text-gray-400 italic">Disponible après un premier bilan.</p>
      <% end %>
    </div>

  </div>

  <%# CTA nouvelle note %>
  <%= link_to new_patient_note_path(@patient), class: "flex items-center justify-center gap-2 w-full py-4 rounded-2xl bg-sp-primary text-white text-center font-semibold text-base mb-5 shadow-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
    </svg>
    Démarrer une séance
  <% end %>

  <%# Bilan initial %>
  <div class="flex items-center justify-between mb-2">
    <p class="text-xs font-semibold text-gray-400 tracking-widest uppercase">Bilan initial</p>
    <% if @patient.bilan %>
      <p class="text-xs text-gray-400"><%= @patient.bilan.updated_at.strftime("%-d %b %Y") %></p>
    <% end %>
  </div>
  <div class="bg-white rounded-2xl p-4 shadow-sm mb-5">
      <p class="text-xs font-bold text-sp-accent uppercase tracking-widest mb-2 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        Assistant - résumé du bilan
      </p>
    <% if @patient.bilan&.status == "processing" %>
      <%= turbo_stream_from "bilan_summary_#{@patient.id}" %>
      <turbo-frame id="bilan_summary_<%= @patient.id %>">
        <%= render "patients/bilan_summary", bilan: @patient.bilan %>
      </turbo-frame>
    <% elsif @patient.bilan&.status == "done" %>
      <%= turbo_stream_from "bilan_summary_#{@patient.id}" %>
      <details>
        <summary class="cursor-pointer list-none">
          <turbo-frame id="bilan_summary_<%= @patient.id %>">
            <%= render "patients/bilan_summary", bilan: @patient.bilan %>
          </turbo-frame>
          <span class="text-xs text-sp-accent font-medium mt-2 inline-block">Voir le bilan complet ›</span>
        </summary>
        <div class="mt-3 pt-3 border-t border-gray-100">
          <div class="prose prose-sm text-gray-800 max-w-none"><%= render_markdown(@patient.bilan.content) %></div>
          <span onclick="this.closest('details').removeAttribute('open')"
                class="text-xs text-sp-accent font-medium mt-3 inline-block cursor-pointer">Réduire ‹</span>
        </div>
      </details>
      <div class="flex items-center gap-3 mt-3">
        <%= link_to patient_bilan_path(@patient), class: "inline-flex items-center gap-1 text-xs text-sp-accent font-medium" do %>
          Ouvrir le bilan
        <% end %>
        <%= link_to recording_patient_bilan_path(@patient), class: "inline-flex items-center gap-1 text-xs text-gray-400 font-medium" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
          </svg>
          Nouvelle écoute
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-400 italic mb-3">Aucun bilan généré pour ce patient.</p>
      <div class="flex gap-2">
        <%= link_to recording_patient_bilan_path(@patient),
              class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-sp-primary text-white text-sm font-medium" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
          </svg>
          Démarrer une écoute
        <% end %>
        <%= link_to new_patient_bilan_path(@patient),
              class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-gray-200 text-gray-500 text-sm font-medium" do %>
          Rédiger manuellement
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Pièces jointes %>
  <div class="bg-white rounded-2xl p-4 shadow-sm mb-5" data-controller="media-modal">

    <%# Notification erreur %>
    <div data-media-modal-target="notification"
         class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-red-100 text-red-800 px-4 py-2 rounded-lg shadow text-sm max-w-xs text-center">
    </div>

    <%# Overlay chargement %>
    <div data-media-modal-target="loading"
         class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-6">
      <div class="bg-white rounded-2xl p-6 w-72 shadow-xl">
        <p class="text-sm font-semibold text-sp-primary text-center mb-4">Envoi en cours…</p>
        <div class="w-full bg-gray-100 rounded-full h-2 mb-2 overflow-hidden">
          <div data-media-modal-target="progressBar" class="bg-sp-accent h-2 rounded-full transition-all duration-200" style="width: 0%"></div>
        </div>
        <p data-media-modal-target="progressText" class="text-xs text-gray-400 text-center">0 %</p>
      </div>
    </div>

    <%# En-tête %>
    <div class="flex items-center justify-between mb-3">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Pièces jointes</p>
      <label for="patient_file_upload_input" class="w-7 h-7 rounded-full bg-sp-primary flex items-center justify-center cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </label>
    </div>

    <%# Grille de médias %>
    <% if @patient.files.attached? %>
      <div class="grid grid-cols-3 gap-2">
        <% @patient.files.attachments.each do |attachment| %>
          <% blob = attachment.blob %>
          <div class="relative aspect-square rounded-xl overflow-hidden bg-gray-100">
            <% if blob.image? %>
              <%= image_tag url_for(blob),
                    class: "w-full h-full object-cover cursor-pointer",
                    data: { action: "click->media-modal#open", src: url_for(blob), type: "image" },
                    alt: "" %>
            <% elsif blob.video? %>
              <div class="w-full h-full flex items-center justify-center bg-gray-800 cursor-pointer"
                   data-action="click->media-modal#open"
                   data-src="<%= url_for(blob) %>"
                   data-type="video">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white/80" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            <% end %>
            <%= form_with url: remove_file_patient_path(@patient, attachment_id: attachment.id), method: :delete do %>
              <button type="button"
                      data-action="click->media-modal#confirmDelete"
                      class="absolute top-1 right-1 w-6 h-6 bg-black/50 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-400 italic">Aucune pièce jointe.</p>
    <% end %>

    <%# Formulaire upload %>
    <%= form_with url: add_files_patient_path(@patient), method: :post do |f| %>
      <%= f.file_field :files, multiple: true, accept: "image/*,video/*",
            id: "patient_file_upload_input", class: "hidden",
            direct_upload: true,
            data: { action: "change->media-modal#validateAndSubmit" } %>
    <% end %>

    <%# Modale confirmation suppression %>
    <div data-media-modal-target="confirmModal"
         class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl p-6 w-72 shadow-xl">
        <p class="text-sm font-semibold text-sp-primary mb-1">Supprimer ce fichier ?</p>
        <p class="text-xs text-gray-500 mb-5">Cette action est irréversible.</p>
        <div class="flex gap-3">
          <button data-action="click->media-modal#closeConfirm"
                  class="flex-1 py-2 rounded-xl border border-gray-200 text-sm text-gray-600">Annuler</button>
          <button data-action="click->media-modal#confirmDeleteSubmit"
                  class="flex-1 py-2 rounded-xl bg-red-500 text-white text-sm font-semibold">Supprimer</button>
        </div>
      </div>
    </div>

    <%# Modal lecteur média %>
    <div data-media-modal-target="modal"
         class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4"
         data-action="click->media-modal#closeOnBackdrop">
      <button data-action="click->media-modal#close"
              class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-white z-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <%= image_tag "data:,", data: { "media-modal-target": "image" }, class: "hidden max-w-full max-h-[85vh] rounded-xl object-contain", alt: "" %>
      <video data-media-modal-target="video" class="hidden max-w-full max-h-[85vh] rounded-xl" controls playsinline></video>
    </div>

  </div>

  <%# Comptes rendus %>
  <% if @notes.any? %>
    <p class="text-xs font-semibold text-gray-400 tracking-widest uppercase mb-3">
      <%= @notes.count %> compte<%= @notes.count > 1 ? "s" : "" %>-rendu<%= @notes.count > 1 ? "s" : "" %>
    </p>
    <div class="flex flex-col gap-3">
      <% @notes.each do |note| %>
        <div class="bg-white rounded-2xl p-4 shadow-sm">
          <div class="flex items-start justify-between gap-2">
            <%= link_to note_path(note, back: "patient"), class: "flex-1 min-w-0" do %>
              <div class="flex items-center gap-2 mb-1">
                <% if note.important? %>
                  <span class="w-2 h-2 rounded-full bg-sp-accent flex-shrink-0"></span>
                <% end %>
                <p class="font-semibold text-sp-primary text-sm truncate"><%= note.title.presence || "Sans titre" %></p>
              </div>
              <% if note.content.present? %>
                <p class="text-xs text-gray-500 line-clamp-2"><%= note.content %></p>
              <% end %>
              <p class="text-xs text-gray-400 mt-2 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <%= note.created_at.strftime("%-d %b %Y") %>
              </p>
            <% end %>
            <div class="flex gap-2 flex-shrink-0">
              <%= link_to edit_note_path(note, back: "patient"), class: "w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              <% end %>
              <%= button_to note_path(note), method: :delete,
                  data: { turbo_confirm: "Supprimer cette note ? Cette action est irréversible." },
                  class: "w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center border-0 cursor-pointer" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sp-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-10">
      <p class="text-gray-400 text-sm">Aucune note pour ce patient.</p>
    </div>
  <% end %>

</div>
