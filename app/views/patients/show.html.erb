<% content_for :title, @patient.name %>

<%# Header %>
<div class="flex items-center justify-between px-4 py-4 bg-sp-bg sticky top-0 z-10">
  <%= link_to patients_path, class: "flex items-center gap-1 text-sp-accent text-sm font-medium" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    Patients
  <% end %>
  <h1 class="text-base font-semibold text-sp-primary">Fiche patient</h1>
  <%= link_to edit_patient_path(@patient), class: "w-8 h-8 rounded-lg bg-white flex items-center justify-center shadow-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
    </svg>
  <% end %>
</div>

<div class="px-4">
  <%# Hero patient %>
  <div class="bg-white rounded-2xl p-5 shadow-sm mb-5 flex items-center gap-4">
    <div class="w-16 h-16 rounded-full <%= patient_avatar_color(@patient.name) %> flex items-center justify-center flex-shrink-0">
      <span class="text-xl font-bold text-gray-700"><%= patient_initials(@patient.name) %></span>
    </div>
    <div>
      <p class="text-xl font-bold text-sp-primary"><%= @patient.name %></p>
      <p class="text-sm text-gray-500"><%= @patient.age %> ans</p>
      <% if @patient.pathology.present? %>
        <span class="inline-block mt-1 px-3 py-1 rounded-full text-xs font-medium bg-sp-accent/20 text-sp-primary">
          <%= @patient.pathology %>
        </span>
      <% end %>
    </div>
  </div>

  <%# CTA nouvelle note %>
  <%= link_to new_patient_note_path(@patient), class: "block w-full py-4 rounded-2xl bg-sp-primary text-white text-center font-semibold text-base mb-5 shadow-sm" do %>
    + Nouvelle note
  <% end %>

  <%# Liste des notes %>
  <% if @notes.any? %>
    <p class="text-xs font-semibold text-gray-400 tracking-widest uppercase mb-3">
      <%= @notes.count %> compte<%= @notes.count > 1 ? "s" : "" %>-rendu<%= @notes.count > 1 ? "s" : "" %>
    </p>
    <div class="flex flex-col gap-3">
      <% @notes.each do |note| %>
        <div class="bg-white rounded-2xl p-4 shadow-sm">
          <div class="flex items-start justify-between gap-2">
            <%= link_to note_path(note, back: "patient"), class: "flex-1 min-w-0" do %>
              <div class="flex items-center gap-2 mb-1">
                <% if note.important? %>
                  <span class="w-2 h-2 rounded-full bg-sp-accent flex-shrink-0"></span>
                <% end %>
                <p class="font-semibold text-sp-primary text-sm truncate"><%= note.title.presence || "Sans titre" %></p>
              </div>
              <% if note.content.present? %>
                <p class="text-xs text-gray-500 line-clamp-2"><%= note.content %></p>
              <% end %>
              <p class="text-xs text-gray-400 mt-2 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <%= note.created_at.strftime("%-d %b %Y") %>
              </p>
            <% end %>
            <div class="flex gap-2 flex-shrink-0">
              <%= link_to edit_note_path(note, back: "patient"), class: "w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              <% end %>
              <%= button_to note_path(note), method: :delete,
                  data: { turbo_confirm: "Supprimer cette note ? Cette action est irréversible." },
                  class: "w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center border-0 cursor-pointer" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sp-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-10">
      <p class="text-gray-400 text-sm">Aucune note pour ce patient.</p>
    </div>
  <% end %>
</div>
