<%= form_with model: patient, class: "flex flex-col gap-5" do |f| %>
  <% if patient.errors.any? %>
    <div class="bg-red-50 rounded-xl p-4">
      <% patient.errors.full_messages.each do |msg| %>
        <p class="text-sm text-red-700"><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Nom complet</label>
    <%= f.text_field :name, placeholder: "Martin Dupont",
        class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
  </div>

  <div>
    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Âge</label>
    <%= f.number_field :age, placeholder: "42",
        class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
  </div>

  <div>
    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Pathologie</label>
    <%= f.text_field :pathology, placeholder: "Rupture LCA droit — rééducation post-op",
        class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
  </div>

  <div class="flex flex-col gap-3 mt-2">
    <%= f.submit patient.persisted? ? "Enregistrer les modifications" : "Ajouter le patient",
        class: "w-full py-4 rounded-2xl bg-sp-primary text-white font-semibold text-base cursor-pointer" %>
    <%= link_to "Annuler", patient.persisted? ? patient_path(patient) : patients_path,
        class: "w-full py-4 rounded-2xl bg-transparent text-gray-500 font-medium text-base text-center" %>
  </div>
<% end %>
