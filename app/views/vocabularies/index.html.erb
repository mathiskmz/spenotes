<% content_for :title, "Vocabulaire" %>

<div class="px-4 pt-6">
  <%# Header %>
  <div class="flex items-center justify-between mb-5">
    <h1 class="text-2xl font-bold text-sp-primary">Vocabulaire</h1>
    <span class="text-sm text-gray-400"><%= @vocabularies.count %> terme<%= @vocabularies.count > 1 ? "s" : "" %> sur <%= @limit %> maximum</span>
  </div>

  <%# Bannière d'aide %>
  <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-5 flex items-start gap-2">
    <span class="text-base">💡</span>
    <p class="text-xs text-amber-800">Ces termes améliorent la reconnaissance lors de la dictée et de l'écoute réunion.</p>
  </div>

  <%# Filtres catégories %>
  <div class="flex gap-2 overflow-x-auto pb-2 mb-5 scrollbar-none">
    <%= link_to vocabularies_path,
        class: "px-4 py-2 rounded-full text-sm font-medium flex-shrink-0 #{params[:category].blank? ? 'bg-sp-primary text-white' : 'bg-white text-gray-600 border border-gray-200'}" do %>
      Tous
    <% end %>
    <% @categories.each do |cat| %>
      <%= link_to vocabularies_path(category: cat),
          class: "px-4 py-2 rounded-full text-sm font-medium flex-shrink-0 #{params[:category] == cat ? 'bg-sp-primary text-white' : 'bg-white text-gray-600 border border-gray-200'}" do %>
        <%= cat %>
      <% end %>
    <% end %>
  </div>

  <%# Vocabulaire de base %>
  <details class="mb-5">
    <summary class="text-xs text-gray-400 cursor-pointer select-none">
      Liste de mots-clés définis par défaut selon la profession indiquée pour améliorer la transcription (<%= @base_keywords.count %>)
    </summary>
    <div class="mt-2 flex flex-wrap gap-1.5">
      <% @base_keywords.each do |kw| %>
        <span class="text-xs text-gray-400 bg-sp-bg px-2 py-0.5 rounded-full"><%= kw %></span>
      <% end %>
    </div>
  </details>

  <%# Formulaire d'ajout %>
  <div class="bg-white rounded-2xl p-4 shadow-sm mb-5">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Ajouter un terme</p>
    <%= form_with model: @vocabulary, url: vocabularies_path, class: "flex flex-col gap-3" do |f| %>
      <div class="grid grid-cols-2 gap-3">
        <%= f.text_field :input, placeholder: "LCA",
            class: "bg-sp-bg border border-gray-200 rounded-xl px-3 py-2 text-sm text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent" %>
        <%= f.text_field :output, placeholder: "Ligament croisé antérieur",
            class: "bg-sp-bg border border-gray-200 rounded-xl px-3 py-2 text-sm text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent" %>
      </div>
      <div class="flex gap-3">
        <%= f.select :category, @categories,
            { prompt: "Catégorie" },
            class: "flex-1 bg-sp-bg border border-gray-200 rounded-xl px-3 py-2 text-sm text-sp-primary focus:outline-none focus:border-sp-accent" %>
        <%= f.submit "+",
            class: "w-10 h-10 bg-sp-primary text-white rounded-xl font-bold text-lg cursor-pointer flex-shrink-0" %>
      </div>
    <% end %>
  </div>

  <%# Liste des termes %>
  <% if @vocabularies.any? %>
    <div class="flex flex-col gap-2">
      <% @vocabularies.each do |vocab| %>
        <div class="bg-white rounded-2xl px-4 py-3 shadow-sm flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full flex-shrink-0 <%= category_dot_color(vocab.category) %>"></span>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-sp-primary"><%= vocab.input %></p>
            <p class="text-xs text-gray-500 truncate"><%= vocab.output %></p>
          </div>
          <span class="px-2 py-1 rounded-full text-xs font-medium flex-shrink-0 <%= category_badge_color(vocab.category) %>">
            <%= vocab.category %>
          </span>
          <%= button_to vocabulary_path(vocab), method: :delete,
              data: { turbo_confirm: "Supprimer \"#{vocab.input}\" ?" },
              class: "w-7 h-7 rounded-lg bg-red-50 flex items-center justify-center border-0 cursor-pointer flex-shrink-0" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-sp-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-10">
      <p class="text-gray-400 text-sm">Aucun terme pour cette catégorie.</p>
    </div>
  <% end %>
</div>
