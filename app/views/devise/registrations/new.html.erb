<% content_for :title, "Créer un compte" %>

<div class="min-h-screen flex flex-col justify-center px-6 py-10">
  <%# Header retour %>
  <div class="mb-8">
    <%= link_to new_user_session_path, class: "inline-flex items-center gap-1 text-sm text-sp-accent font-medium mb-6" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Connexion
    <% end %>
    <h1 class="text-3xl font-bold text-sp-primary leading-tight">Créer<br>votre compte.</h1>
    <p class="text-gray-500 text-sm mt-2">Rejoignez Spenotes et commencez à noter plus vite.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: "flex flex-col gap-4") do |f| %>
    <% if resource.errors.any? %>
      <div class="bg-red-50 rounded-xl px-4 py-3">
        <% resource.errors.full_messages.each do |msg| %>
          <p class="text-sm text-red-700"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Nom complet</label>
      <%= f.text_field :name, autofocus: true, autocomplete: "name",
          placeholder: "Dr. Julie Moreau",
          class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
    </div>

    <div>
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Email</label>
      <%= f.email_field :email, autocomplete: "email",
          placeholder: "vous@cabinet.fr",
          class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
    </div>

    <div>
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Mot de passe</label>
      <%= f.password_field :password, autocomplete: "new-password",
          placeholder: "8 caractères minimum",
          class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-gray-400 mt-1"><%= @minimum_password_length %> caractères minimum</p>
      <% end %>
    </div>

    <div>
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Confirmation mot de passe</label>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
          placeholder: "••••••••",
          class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
    </div>

    <div class="mt-2">
      <%= f.submit "Créer mon compte",
          class: "w-full py-4 rounded-2xl bg-sp-primary text-white font-semibold text-base cursor-pointer" %>
    </div>
  <% end %>

  <p class="text-center text-sm text-gray-500 mt-6">
    Déjà un compte ?
    <%= link_to "Se connecter", new_user_session_path, class: "text-sp-accent font-semibold" %>
  </p>
</div>
