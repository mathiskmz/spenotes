<% content_for :title, "Connexion" %>

<div class="min-h-screen flex flex-col justify-center px-6 py-10">
  <%# Brand block %>
  <div class="mb-10">
    <div class="w-16 h-16 rounded-2xl bg-sp-primary flex items-center justify-center mb-5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-sp-primary leading-tight">Bon retour,<br>praticien.</h1>
    <p class="text-gray-500 text-sm mt-2">Connectez-vous pour accéder à vos patients et vos notes.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "flex flex-col gap-4") do |f| %>
    <% if alert.present? %>
      <div class="bg-red-50 rounded-xl px-4 py-3 text-sm text-red-700">
        <%= alert %>
      </div>
    <% end %>

    <div>
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Email</label>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
          placeholder: "vous@cabinet.fr",
          class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
    </div>

    <div>
      <div class="flex items-center justify-between mb-2">
        <label class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Mot de passe</label>
        <%= link_to "Mot de passe oublié ?", new_user_password_path, class: "text-xs text-sp-accent font-medium" %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password",
          placeholder: "••••••••",
          class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
    </div>

    <div class="mt-2">
      <%= f.submit "Se connecter",
          class: "w-full py-4 rounded-2xl bg-sp-primary text-white font-semibold text-base cursor-pointer" %>
    </div>
  <% end %>

  <p class="text-center text-sm text-gray-500 mt-6">
    Pas encore de compte ?
    <%= link_to "Créer un compte", new_user_registration_path, class: "text-sp-accent font-semibold" %>
  </p>
</div>
