<% content_for :title, "Réglages" %>

<div class="px-4 pt-6">
  <h1 class="text-2xl font-bold text-sp-primary mb-5">Réglages</h1>

  <%# Carte profil %>
  <div class="bg-white rounded-2xl shadow-sm mb-5">
    <%= form_with model: @user, url: settings_path, method: :patch, class: "p-4" do |f| %>
      <div class="flex items-center gap-4 mb-4 pb-4 border-b border-gray-100">
        <div class="w-14 h-14 rounded-full bg-sp-accent/30 flex items-center justify-center flex-shrink-0">
          <span class="text-lg font-bold text-sp-primary">
            <%= (@user.name.presence || @user.email).split.first(2).map { |w| w[0].upcase }.join %>
          </span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sp-primary truncate"><%= @user.name.presence || @user.email %></p>
          <p class="text-xs text-gray-400 truncate"><%= @user.email %></p>
          <% if @user.sector.present? %>
            <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-xs font-medium bg-sp-accent/20 text-sp-primary">
              <%= @user.sector %>
            </span>
          <% end %>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Nom complet</label>
          <%= f.text_field :name, placeholder: "Dr. Prénom Nom",
              class: "w-full bg-sp-bg border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 text-sm focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Spécialité</label>
          <%= f.text_field :sector, placeholder: "Kinésithérapeute",
              class: "w-full bg-sp-bg border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 text-sm focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
        </div>
        <%= f.submit "Enregistrer",
            class: "w-full py-3 rounded-xl bg-sp-primary text-white font-semibold text-sm cursor-pointer mt-2" %>
      </div>
    <% end %>
  </div>

  <%# Transcription & IA %>
  <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Transcription & IA</p>
  <div class="bg-white rounded-2xl shadow-sm overflow-hidden mb-5">
    <%= link_to vocabularies_path, class: "flex items-center gap-3 p-4 border-b border-gray-100" do %>
      <span class="text-xl">📚</span>
      <div class="flex-1">
        <p class="text-sm font-medium text-sp-primary">Vocabulaire personnalisé</p>
        <p class="text-xs text-gray-400"><%= current_user.vocabularies.count %> termes</p>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    <% end %>

    <%# Langue de dictée (placeholder) %>
    <div class="flex items-center gap-3 p-4 border-b border-gray-100 opacity-50">
      <span class="text-xl">🌐</span>
      <div class="flex-1">
        <p class="text-sm font-medium text-sp-primary">Langue de dictée</p>
        <p class="text-xs text-gray-400">Français</p>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </div>

    <%# Toggle Recommandations IA (placeholder) %>
    <div class="flex items-center gap-3 p-4 border-b border-gray-100 opacity-50">
      <span class="text-xl">✨</span>
      <p class="flex-1 text-sm font-medium text-sp-primary">Recommandations IA</p>
      <div class="w-11 h-6 bg-sp-accent rounded-full relative cursor-not-allowed">
        <div class="w-5 h-5 bg-white rounded-full absolute right-0.5 top-0.5 shadow-sm"></div>
      </div>
    </div>

    <%# Toggle Transcription brute (placeholder) %>
    <div class="flex items-center gap-3 p-4 opacity-50">
      <span class="text-xl">📄</span>
      <p class="flex-1 text-sm font-medium text-sp-primary">Conserver transcription brute</p>
      <div class="w-11 h-6 bg-sp-accent rounded-full relative cursor-not-allowed">
        <div class="w-5 h-5 bg-white rounded-full absolute right-0.5 top-0.5 shadow-sm"></div>
      </div>
    </div>
  </div>

  <%# Compte %>
  <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Compte</p>
  <div class="bg-white rounded-2xl shadow-sm overflow-hidden mb-5">
    <%= link_to edit_user_registration_path, class: "flex items-center gap-3 p-4 border-b border-gray-100" do %>
      <span class="text-xl">🔒</span>
      <p class="flex-1 text-sm font-medium text-sp-primary">Changer le mot de passe</p>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    <% end %>
    <%= button_to destroy_user_session_path, method: :delete,
        class: "w-full flex items-center gap-3 p-4 border-b border-gray-100 border-0 bg-transparent cursor-pointer text-left" do %>
      <span class="text-xl">🚪</span>
      <p class="flex-1 text-sm font-medium text-sp-accent">Se déconnecter</p>
    <% end %>
    <%= button_to registration_path(:user), method: :delete,
        data: { turbo_confirm: "Supprimer définitivement votre compte et toutes vos données ? Cette action est irréversible." },
        class: "w-full flex items-center gap-3 p-4 border-0 bg-transparent cursor-pointer text-left" do %>
      <span class="text-xl">🗑</span>
      <p class="flex-1 text-sm font-medium text-sp-danger">Supprimer mon compte</p>
    <% end %>
  </div>

  <p class="text-center text-xs text-gray-300 pb-4">Spenotes · version 0.1.0 MVP</p>
</div>
