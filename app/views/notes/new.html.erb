<% content_for :title, "Nouvelle note" %>

<%# L'action du formulaire dépend du contexte : imbriqué (avec patient) ou standalone %>
<%= form_with model: @patient ? [@patient, @note] : @note,
              url: @patient ? patient_notes_path(@patient) : notes_path,
              class: "flex flex-col min-h-screen" do |f| %>

  <%# Header %>
  <div class="flex items-center justify-between px-4 py-4">
    <%= link_to @patient ? patient_path(@patient) : notes_path,
        class: "text-sp-accent text-sm font-medium" do %>
      ‹ Annuler
    <% end %>
    <h1 class="text-base font-semibold text-sp-primary">Nouvelle note</h1>
    <%= f.submit "Enreg.", class: "px-4 py-2 rounded-full bg-sp-primary text-white text-sm font-semibold cursor-pointer" %>
  </div>

  <%# Erreurs %>
  <% if @note&.errors&.any? %>
    <div class="mx-4 mb-3 bg-red-50 rounded-xl p-4">
      <% @note.errors.full_messages.each do |msg| %>
        <p class="text-sm text-red-700"><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <%# ── CAS 1 : patient déjà connu (depuis la fiche patient) ── %>
  <% if @patient %>
    <div class="px-4 mb-3">
      <p class="text-sm text-sp-accent font-medium flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <%= @patient.name %>
        <% if @patient.pathology.present? %>
          <span class="text-gray-400">· <%= @patient.pathology %></span>
        <% end %>
      </p>
    </div>

  <%# ── CAS 2 : sélection du patient depuis notes#index ── %>
  <% else %>
    <div class="px-4 mb-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Patient</p>

      <%# Patients existants %>
      <% if @patients.any? %>
        <div class="mb-4">
          <label class="block text-xs text-gray-500 mb-1.5">Patient existant</label>
          <select name="patient_id"
              class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary focus:outline-none focus:border-sp-accent">
            <option value="">— Sélectionner —</option>
            <% @patients.each do |patient| %>
              <option value="<%= patient.id %>"><%= patient.name %><%= " · #{patient.pathology}" if patient.pathology.present? %></option>
            <% end %>
          </select>
        </div>
        <div class="flex items-center gap-3 mb-4">
          <div class="flex-1 h-px bg-gray-200"></div>
          <span class="text-xs text-gray-400">ou créer un nouveau</span>
          <div class="flex-1 h-px bg-gray-200"></div>
        </div>
      <% end %>

      <%# Nouveau patient inline %>
      <div class="bg-white rounded-2xl p-4 border border-gray-200 flex flex-col gap-3">
        <input type="text" name="new_patient_name" placeholder="Nom complet *" autocomplete="off"
            class="w-full bg-sp-bg border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent">
        <div class="grid grid-cols-2 gap-3">
          <input type="number" name="new_patient_age" placeholder="Âge" autocomplete="off"
              class="w-full bg-sp-bg border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent">
          <input type="text" name="new_patient_pathology" placeholder="Pathologie" autocomplete="off"
              class="w-full bg-sp-bg border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent">
        </div>
      </div>
    </div>
  <% end %>

  <%# Titre %>
  <div class="px-4 mb-3">
    <%= f.text_field :title, placeholder: "Titre de la séance…",
        class: "w-full bg-transparent text-xl font-bold text-sp-primary placeholder-gray-300 focus:outline-none border-b border-gray-200 pb-3" %>
  </div>

  <%# Contenu %>
  <div class="px-4 flex-1 mb-4">
    <%= f.text_area :content, placeholder: "Rédigez votre compte-rendu…",
        rows: 8,
        class: "w-full bg-transparent text-sm text-gray-800 placeholder-gray-400 focus:outline-none resize-none leading-relaxed" %>
  </div>

  <%# Important toggle %>
  <div class="px-4 mb-4 flex items-center gap-3">
    <%= f.check_box :important, class: "w-4 h-4 accent-sp-accent" %>
    <label class="text-sm text-gray-600">Marquer comme important</label>
  </div>

  <%# Pièces jointes (placeholder) %>
  <div class="px-4 mb-4">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Pièces jointes</p>
    <div class="flex gap-3">
      <div class="w-16 h-16 rounded-xl border-2 border-dashed border-gray-300 flex items-center justify-center opacity-50 cursor-not-allowed">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </div>
      <p class="text-xs text-gray-400 self-center italic">Bientôt disponible</p>
    </div>
  </div>

  <%# Barre de modes de saisie %>
  <div class="border-t border-gray-200 bg-white grid grid-cols-4 pb-safe">
    <div class="flex flex-col items-center gap-1 py-3 text-sp-primary border-t-2 border-sp-primary">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 7H7a2 2 0 00-2 2v8a2 2 0 002 2h10a2 2 0 002-2V9a2 2 0 00-2-2h-2M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2M9 7h6" />
      </svg>
      <span class="text-xs font-semibold">Clavier</span>
    </div>
    <div class="flex flex-col items-center gap-1 py-3 text-gray-300 cursor-not-allowed">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
      </svg>
      <span class="text-xs">Dictée</span>
    </div>
    <div class="flex flex-col items-center gap-1 py-3 text-gray-300 cursor-not-allowed">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M12 9.5v5M6.464 8.464a5 5 0 000 7.072" />
      </svg>
      <span class="text-xs">Écoute</span>
    </div>
    <div class="flex flex-col items-center gap-1 py-3 text-gray-300 cursor-not-allowed">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
      </svg>
      <span class="text-xs">Joindre</span>
    </div>
  </div>
<% end %>
