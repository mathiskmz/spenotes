<% content_for :title, "Mes notes" %>

<div class="px-4 pt-6">
  <div class="flex items-center justify-between mb-5">
    <h1 class="text-2xl font-bold text-sp-primary">Mes notes</h1>
    <div class="flex items-center gap-3">
      <span class="text-sm text-gray-400"><%= @notes.count %> note<%= @notes.count > 1 ? "s" : "" %></span>
      <%= link_to new_note_path, class: "w-10 h-10 rounded-full bg-sp-primary flex items-center justify-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      <% end %>
    </div>
  </div>

  <% if @notes.any? %>
    <div class="flex flex-col gap-3">
      <% @notes.each do |note| %>
        <div class="bg-white rounded-2xl p-4 shadow-sm">
          <%# Fil d'Ariane patient %>
          <%= link_to patient_path(note.patient), class: "inline-flex items-center gap-1 text-xs text-sp-accent font-medium mb-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <%= note.patient.name %>
          <% end %>

          <div class="flex items-start justify-between gap-2">
            <%= link_to note_path(note), class: "flex-1 min-w-0" do %>
              <div class="flex items-center gap-2 mb-1">
                <% if note.important? %>
                  <span class="w-2 h-2 rounded-full bg-sp-accent flex-shrink-0"></span>
                <% end %>
                <p class="font-semibold text-sp-primary text-sm"><%= note.title.presence || "Sans titre" %></p>
              </div>
              <% if note.content.present? %>
                <p class="text-xs text-gray-500 line-clamp-2"><%= note.content %></p>
              <% end %>
              <p class="text-xs text-gray-400 mt-2 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <%= note.created_at.strftime("%-d %b %Y") %>
              </p>
            <% end %>

            <div class="flex gap-2 flex-shrink-0">
              <%= link_to edit_note_path(note), class: "w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              <% end %>
              <%= button_to note_path(note), method: :delete,
                  data: { turbo_confirm: "Supprimer cette note ? Cette action est irréversible." },
                  class: "w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center border-0 cursor-pointer" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sp-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16">
      <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-sp-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <p class="text-gray-500 text-sm">Aucune note pour l'instant</p>
      <p class="text-gray-400 text-xs mt-1">Créez une note depuis la fiche d'un patient.</p>
    </div>
  <% end %>
</div>
