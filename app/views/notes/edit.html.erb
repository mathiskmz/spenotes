<% content_for :title, "Modifier la note" %>

<%= form_with model: @note, class: "flex flex-col" do |f| %>
  <%# Header %>
  <div class="flex items-center justify-between px-4 py-4">
    <%= link_to patient_path(@note.patient), class: "flex items-center gap-1 text-sp-accent text-sm font-medium" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      <%= @note.patient.name %>
    <% end %>
    <h1 class="text-base font-semibold text-sp-primary">Modifier la note</h1>
    <%= f.submit "Enregistrer", class: "px-4 py-2 rounded-full bg-sp-primary text-white text-sm font-semibold cursor-pointer" %>
  </div>

  <% if @note.errors.any? %>
    <div class="mx-4 mb-3 bg-red-50 rounded-xl p-4">
      <% @note.errors.full_messages.each do |msg| %>
        <p class="text-sm text-red-700"><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="px-4">
    <%# Titre %>
    <div class="mb-4">
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Titre de la note</label>
      <%= f.text_field :title, placeholder: "Titre de la séance…",
          class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sp-primary placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent" %>
    </div>

    <%# Contenu %>
    <div class="mb-4">
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Contenu</label>
      <%= f.text_area :content, placeholder: "Contenu de la note…",
          rows: 8,
          class: "w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-sp-accent focus:ring-1 focus:ring-sp-accent resize-none leading-relaxed" %>
    </div>

    <%# Important %>
    <div class="flex items-center gap-3 mb-6">
      <%= f.check_box :important, class: "w-4 h-4 accent-sp-accent" %>
      <label class="text-sm text-gray-600">Marquer comme important</label>
    </div>

    <%# Pièces jointes %>
    <div class="mb-8">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Pièces jointes</p>
      <% if @note.files.attached? %>
        <div class="flex flex-wrap gap-2 mb-3">
          <% @note.files.each do |attachment| %>
            <div class="relative w-20 h-20 rounded-xl overflow-hidden bg-gray-100">
              <% if attachment.content_type.start_with?("image/") %>
                <%= image_tag attachment, class: "w-full h-full object-cover", alt: "" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.069A1 1 0 0121 8.87v6.26a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z" />
                  </svg>
                </div>
              <% end %>
              <%= button_to remove_file_note_path(@note, attachment_id: attachment.id), method: :delete,
                  data: { turbo_confirm: "Supprimer ce fichier ?" },
                  class: "absolute top-1 right-1 w-6 h-6 bg-black/50 rounded-full flex items-center justify-center border-0 cursor-pointer" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      <p class="text-xs text-gray-400">Les fichiers ajoutés seront enregistrés avec la note.</p>
    </div>

    <%# File input caché — déclenché par le bouton Joindre %>
    <%= f.file_field :files, multiple: true, accept: "image/*,video/*",
        id: "note_files_edit_input", class: "hidden" %>

    <%# Zone dangereuse %>
    <div class="border border-red-200 rounded-2xl p-4">
      <p class="text-xs font-semibold text-red-500 uppercase tracking-wide mb-3">⚠ Zone dangereuse</p>
      <p class="text-xs text-gray-500 mb-4">La suppression de cette note est irréversible.</p>
      <%= button_to note_path(@note), method: :delete,
          data: { turbo_confirm: "Supprimer cette note ? Cette action est irréversible." },
          class: "w-full py-3 rounded-xl bg-red-50 text-sp-danger font-semibold text-sm border border-red-200 cursor-pointer" do %>
        Supprimer cette note
      <% end %>
    </div>
  </div>
<% end %>

<%# Boutons de modes — fixés au-dessus de la tab bar, alignés dans max-w-md %>
<div class="fixed bottom-20 left-0 right-0 z-30 pointer-events-none">
  <div class="max-w-md mx-auto px-4 flex justify-end">
    <div class="flex flex-col gap-3 pointer-events-auto">

      <%# Joindre %>
      <label for="note_files_edit_input"
             class="w-14 h-14 rounded-full bg-white border border-gray-200 text-sp-primary shadow-lg flex flex-col items-center justify-center gap-0.5 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
        </svg>
        <span class="text-[9px] font-semibold leading-none">Joindre</span>
      </label>

    </div>
  </div>
</div>
