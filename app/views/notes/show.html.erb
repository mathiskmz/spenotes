<% content_for :title, @note.title %>

<%# Header %>
<div class="flex items-center justify-between px-4 py-4 bg-sp-bg sticky top-0 z-10">
  <%= link_to patient_path(@note.patient), class: "flex items-center gap-1 text-sp-accent text-sm font-medium" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    <%= @note.patient.name %>
  <% end %>
  <h1 class="text-base font-semibold text-sp-primary">Compte-rendu</h1>
  <%= link_to edit_note_path(@note), class: "w-8 h-8 rounded-lg bg-white flex items-center justify-center shadow-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
    </svg>
  <% end %>
</div>

<div class="px-4 pb-4">
  <%# Méta note %>
  <div class="flex items-center justify-between mb-1">
    <p class="text-sm text-sp-accent font-medium"><%= @note.patient.name %></p>
    <p class="text-xs text-gray-400"><%= @note.created_at.strftime("%-d %b %Y") %></p>
  </div>

  <div class="flex items-center gap-2 mb-4">
    <h2 class="text-xl font-bold text-sp-primary"><%= @note.title.presence || "Sans titre" %></h2>
    <% if @note.important? %>
      <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-sp-accent/20 text-sp-primary">Important</span>
    <% end %>
  </div>

  <%# Badges sources (placeholder) %>
  <div class="flex gap-2 mb-5">
    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-white border border-gray-200 text-gray-600">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
      Manuelle
    </span>
  </div>

  <%# Contenu %>
  <% if @note.content.present? %>
    <div class="bg-white rounded-2xl p-4 shadow-sm mb-5">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Contenu</p>
      <p class="text-sm text-gray-800 leading-relaxed whitespace-pre-wrap"><%= @note.content %></p>
    </div>
  <% end %>

  <%# Synthèse IA (placeholder désactivé) %>
  <div class="bg-white rounded-2xl p-4 shadow-sm mb-5 opacity-50">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Synthèse IA</p>
    <p class="text-xs text-gray-400 italic">Disponible après une session d'écoute.</p>
  </div>

  <%# Recommandation IA (placeholder désactivé) %>
  <div class="bg-sp-accent/10 border border-sp-accent/30 rounded-2xl p-4 mb-5 opacity-50">
    <p class="text-xs font-semibold text-sp-accent mb-2">✨ Recommandation IA</p>
    <p class="text-xs text-gray-500 italic">Disponible après génération de la synthèse.</p>
  </div>

  <%# Pièces jointes (placeholder) %>
  <div class="bg-white rounded-2xl p-4 shadow-sm mb-5 opacity-50">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Pièces jointes</p>
    <p class="text-xs text-gray-400 italic">Fonctionnalité bientôt disponible.</p>
  </div>
</div>
