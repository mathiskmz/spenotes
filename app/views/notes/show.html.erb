<% content_for :title, @note.title %>

<%# Header %>
<div class="flex items-center justify-between px-4 py-4 bg-sp-bg sticky top-0 z-10">
  <%= link_to patient_path(@note.patient), class: "flex items-center gap-1 text-sp-accent text-sm font-medium" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    <%= @note.patient.name %>
  <% end %>
  <h1 class="text-base font-semibold text-sp-primary">Compte-rendu</h1>
  <%= link_to edit_note_path(@note), class: "w-8 h-8 rounded-lg bg-white flex items-center justify-center shadow-sm" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
    </svg>
  <% end %>
</div>

<div class="px-4 pb-4">
  <%# Méta note %>
  <div class="flex items-center justify-between mb-1">
    <p class="text-sm text-sp-accent font-medium"><%= @note.patient.name %></p>
    <p class="text-xs text-gray-400"><%= @note.created_at.strftime("%-d %b %Y") %></p>
  </div>

  <div class="flex items-center gap-2 mb-4">
    <h2 class="text-xl font-bold text-sp-primary"><%= @note.title.presence || "Sans titre" %></h2>
    <% if @note.important? %>
      <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-sp-accent/20 text-sp-primary">Important</span>
    <% end %>
  </div>

  <%# Badges sources (placeholder) %>
  <div class="flex gap-2 mb-5">
    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-white border border-gray-200 text-gray-600">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
      Manuelle
    </span>
  </div>

  <%# Contenu %>
  <% if @note.content.present? %>
    <div class="bg-white rounded-2xl p-4 shadow-sm mb-5">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Contenu</p>
      <p class="text-sm text-gray-800 leading-relaxed whitespace-pre-wrap"><%= @note.content %></p>
    </div>
  <% end %>

  <%# Synthèse IA (placeholder désactivé) %>
  <div class="bg-white rounded-2xl p-4 shadow-sm mb-5 opacity-50">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Synthèse IA</p>
    <p class="text-xs text-gray-400 italic">Disponible après une session d'écoute.</p>
  </div>

  <%# Recommandation IA (placeholder désactivé) %>
  <div class="bg-sp-accent/10 border border-sp-accent/30 rounded-2xl p-4 mb-5 opacity-50">
    <p class="text-xs font-semibold text-sp-accent mb-2">✨ Recommandation IA</p>
    <p class="text-xs text-gray-500 italic">Disponible après génération de la synthèse.</p>
  </div>

  <%# Pièces jointes %>
  <div class="bg-white rounded-2xl p-4 shadow-sm mb-5" data-controller="media-modal">

    <%# Notification erreur (taille fichier) %>
    <div data-media-modal-target="notification"
         class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-red-100 text-red-800 px-4 py-2 rounded-lg shadow text-sm max-w-xs text-center">
    </div>

    <%# En-tête + bouton upload %>
    <div class="flex items-center justify-between mb-3">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Pièces jointes</p>
      <label for="file_upload_input" class="w-7 h-7 rounded-full bg-sp-primary flex items-center justify-center cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </label>
    </div>

    <%# Grille de médias %>
    <% if @note.files.attached? %>
      <div class="grid grid-cols-3 gap-2">
        <% @note.files.attachments.each do |attachment| %>
          <% blob = attachment.blob %>
          <div class="relative aspect-square rounded-xl overflow-hidden bg-gray-100">

            <% if blob.image? %>
              <%= image_tag url_for(blob),
                    class: "w-full h-full object-cover cursor-pointer",
                    data: { action: "click->media-modal#open", src: url_for(blob), type: "image" },
                    alt: "" %>
            <% elsif blob.video? %>
              <div class="w-full h-full flex items-center justify-center bg-gray-800 cursor-pointer"
                   data-action="click->media-modal#open"
                   data-src="<%= url_for(blob) %>"
                   data-type="video">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white/80" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            <% end %>

            <%# Bouton supprimer (ouvre la modale de confirmation) %>
            <%= form_with url: remove_file_note_path(@note, attachment_id: attachment.id), method: :delete do %>
              <button type="button"
                      data-action="click->media-modal#confirmDelete"
                      class="absolute top-1 right-1 w-6 h-6 bg-black/50 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            <% end %>

          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-400 italic">Aucune pièce jointe.</p>
    <% end %>

    <%# Formulaire upload (déclenché par le label +) %>
    <%= form_with url: add_files_note_path(@note), method: :post do |f| %>
      <%= f.file_field :files, multiple: true, accept: "image/*,video/*",
            id: "file_upload_input", class: "hidden",
            direct_upload: true,
            data: { action: "change->media-modal#validateAndSubmit" } %>
    <% end %>

    <%# Modale confirmation suppression %>
    <div data-media-modal-target="confirmModal"
         class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl p-6 w-72 shadow-xl">
        <p class="text-sm font-semibold text-sp-primary mb-1">Supprimer ce fichier ?</p>
        <p class="text-xs text-gray-500 mb-5">Cette action est irréversible.</p>
        <div class="flex gap-3">
          <button data-action="click->media-modal#closeConfirm"
                  class="flex-1 py-2 rounded-xl border border-gray-200 text-sm text-gray-600">
            Annuler
          </button>
          <button data-action="click->media-modal#confirmDeleteSubmit"
                  class="flex-1 py-2 rounded-xl bg-red-500 text-white text-sm font-semibold">
            Supprimer
          </button>
        </div>
      </div>
    </div>

    <%# Modal lecteur média %>
    <div data-media-modal-target="modal"
         class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4"
         data-action="click->media-modal#closeOnBackdrop">
      <button data-action="click->media-modal#close"
              class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-white z-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <%= image_tag "data:,", data: { "media-modal-target": "image" }, class: "hidden max-w-full max-h-[85vh] rounded-xl object-contain", alt: "" %>
      <video data-media-modal-target="video" class="hidden max-w-full max-h-[85vh] rounded-xl" controls playsinline></video>
    </div>

  </div>
</div>
